{
  "version": "1.9.0",
  "window": {
    "position": [
      100,
      200
    ],
    "size": [
      200,
      200
    ],
    "opacity": 0.9,
    "always_on_top": true,
    "show_on_startup": true
  },
  "behavior": {
    "idle_threshold": 30,
    "sleep_threshold": 300,
    "focus_threshold": 60,
    "focus_debounce": 15,
    "state_switch_cooldown": 1,
    "sound_enabled": true,
    "volume": 0.5
  },
  "tomato": {
    "work_duration": 25,
    "break_duration": 5,
    "long_break_duration": 15,
    "long_break_interval": 4,
    "auto_start_break": false
  },
  "appearance": {
    "orb_size": 52,
    "theme": "default"
  },
  "notification": {
    "enabled": true,
    "rest_reminder_interval": 60,
    "rest_reminder_enabled": true
  },
  "ai": {
    "enabled": true,
    "hotkey_ask": "alt+q",
    "hotkey_translate": "alt+t",
    "hotkey_capture": "alt+s",
    "provider": "openai_compat",
    "base_url": "https://api.deepseek.com/v1",
    "model": "deepseek-chat",
    "vision_model": "",
    "api_key": "",
    "api_key_ref": "",
    "default_preset": "ask",
    "default_language": "zh",
    "response_length": "auto",
    "request_timeout": 60,
    "panel_opacity": 0.95,
    "panel_width": 460,
    "panel_height": 360
  },
  "activity": {
    "enabled": false,
    "retention_days": 30,
    "min_segment_seconds": 5,
    "exclude_apps": [],
    "focus_goal_minutes": 240,
    "nudge_enabled": true,
    "nudge_hour": 18,
    "away_seconds": 300
  },
  "plugins": {
    "disabled": []
  }
}
